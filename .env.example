# Replicate API (required for image generation)
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Instagram Graph API (for Agent 6 - scheduling posts)
# Get these from: https://developers.facebook.com/apps/
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here

# Image hosting URL (images must be publicly accessible for Instagram API)
# Options: AWS S3, Cloudinary, Imgur, etc.
IMAGE_HOST_BASE_URL=https://your-image-host.com/path/

# Schedule posts X days in advance (default: 7 days for review time)
INSTAGRAM_SCHEDULE_DAYS_AHEAD=7

# Ollama (local models - no keys needed)
# Ensure Ollama is running: ollama serve
# Models required: llama3.1, llava:7b
